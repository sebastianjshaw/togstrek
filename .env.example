# Copy to `.env.local` (not committed). Next.js loads it for dev and build.

# --- Site URL (sitemap.xml, robots.txt) ------------------------------------
# Production canonical origin (no trailing slash). Defaults to https://togstrek.com
# NEXT_PUBLIC_SITE_URL=https://togstrek.com

# Staging: block all crawlers (omit sitemap line in robots.txt)
# NEXT_PUBLIC_ROBOTS_NOINDEX=true

# --- Photography CDN (2–4 GB+ site-wide) ---------------------------------
# Use a public HTTPS origin for next/image. Do not store large originals in Git.
# Options: Cloudflare R2 + custom domain, AWS S3 + CloudFront, Cloudinary, Bunny, etc.
# Example hostname you control: media.togstrek.com → point DNS + TLS to your bucket/CDN.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.togstrek.com

# --- Cloudflare R2 (bulk upload: scripts/r2_upload.py) -------------------------
# pip install -r scripts/requirements-r2.txt
# npm run r2:upload -- --source /path/to/files --prefix your/prefix/
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional: R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional: R2_REGION=us-east-1

# Bandwidth: CDN edge caches reduce origin egress; R2→Cloudflare has no egress fee.
# Repo size: keep only code + small assets; images referenced by URL in MDX/frontmatter.

# --- Local HTTrack mirror (migration scripts only) ---------------------------
# tsx does not load .env.local automatically; export in your shell or prefix commands, e.g.:
#   export TOGSTREK_MEDIA_BACKUP_ROOT=/Volumes/MEDIA/TogsTrekBackup
#
# Use the full mirror root if you need HTML for media:fetch-places (togstrek.com/...).
# Use .../images.squarespace-cdn.com/content as --source for media:restructure --discover
# when you only care about indexing Squarespace uploads (~10k–15k files).
#
#   TOGSTREK_MEDIA_BACKUP_ROOT=/Volumes/MEDIA/TogsTrekBackup npm run media:restructure -- --discover
