# Copy to `.env.local` (not committed). Next.js loads it for dev and build.

# --- Vercel production (Dashboard → Environment Variables → Production) -------
# Recommended host: Vercel (see README.md → Deploy).
# Default canonical URL (sitemap, metadata) is https://togstrek.vercel.app if unset.
# When togstrek.com is live: NEXT_PUBLIC_SITE_URL=https://togstrek.com
#   NEXT_PUBLIC_MEDIA_BASE_URL=https://media.togstrek.com
# Do not add R2_* here for the web app — only for local upload/copy scripts.
# Preview/staging only: NEXT_PUBLIC_ROBOTS_NOINDEX=true

# --- Site URL (sitemap.xml, robots.txt) ------------------------------------
# Canonical origin (no trailing slash). Defaults to https://togstrek.vercel.app
# (Vercel preview builds do not infer the host from VERCEL_URL).
# Custom domain: NEXT_PUBLIC_SITE_URL=https://togstrek.com
# NEXT_PUBLIC_SITE_URL=https://togstrek.vercel.app

# Staging: block all crawlers (omit sitemap line in robots.txt)
# NEXT_PUBLIC_ROBOTS_NOINDEX=true

# --- Google Analytics 4 ----------------------------------------------------
# Defaults to G-WFPJ519GNZ in production when unset. Set to empty string to disable.
# For local testing: NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WFPJ519GNZ
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Social (Twitter / X cards) ---------------------------------------------
# Optional handles for twitter:site and twitter:creator (with or without @).
# NEXT_PUBLIC_TWITTER_SITE=togstrek
# NEXT_PUBLIC_TWITTER_CREATOR=yourhandle

# --- Author (JSON-LD Person sameAs — comma or newline separated profile URLs) ---
# NEXT_PUBLIC_AUTHOR_SAMEAS=https://www.instagram.com/yourhandle,https://www.flickr.com/photos/yourhandle

# --- Photography CDN (2–4 GB+ site-wide) ---------------------------------
# Public HTTPS origin for photo URLs in MDX/data (`next/image` loads this directly;
# Vercel Image Optimization is disabled so requests are not proxied through `/_next/image`).
# Do not store large originals in Git. Options: Cloudflare R2 + custom domain, S3 + CDN, etc.
# Example: media.togstrek.com → DNS + TLS to your bucket/CDN (Cloudflare caches at the edge).
# `next.config.ts` allows this URL’s hostname *and* `media.togstrek.com` if you override the env.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.togstrek.com

# --- Cloudflare R2 (bulk upload: scripts/r2_upload.py) -------------------------
# pip install -r scripts/requirements-r2.txt
# npm run r2:upload -- --source /path/to/files --prefix your/prefix/
# North America places: migrate HTML → MDX, download Squarespace images → staging, then R2:
# npm run migrate:places:north-america
# npm run media:fetch-north-america
# npm run r2:upload -- --source migration/cdn-upload-ready/north-america --prefix north-america/
# Accents: macOS paths are often NFD; MDX/URLs are NFC. `r2_upload.py` normalizes to NFC; for
# objects already in the bucket, run: npm run r2:copy-to-nfc -- --prefix your/prefix/ --dry-run
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional: R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional: R2_REGION=us-east-1

# Bandwidth: CDN edge caches reduce origin egress; R2→Cloudflare has no egress fee.
# Repo size: keep only code + small assets; images referenced by URL in MDX/frontmatter.

# --- Local HTTrack mirror (migration scripts only) ---------------------------
# tsx does not load .env.local automatically; export in your shell or prefix commands, e.g.:
#   export TOGSTREK_MEDIA_BACKUP_ROOT=/Volumes/MEDIA/TogsTrekBackup
#
# Use the full mirror root if you need HTML for media:fetch-places (togstrek.com/...).
# Use .../images.squarespace-cdn.com/content as --source for media:restructure --discover
# when you only care about indexing Squarespace uploads (~10k–15k files).
#
#   TOGSTREK_MEDIA_BACKUP_ROOT=/Volumes/MEDIA/TogsTrekBackup npm run media:restructure -- --discover
