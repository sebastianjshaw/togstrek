{
  "name": "togstrek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:fresh": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:turbo:fresh": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "build": "next build --webpack && pagefind --site .next/server/app --output-path public/pagefind",
    "pagefind:index": "pagefind --site .next/server/app --output-path public/pagefind",
    "exif:probe": "tsx scripts/togstrek-exif-probe-cdn.ts",
    "exif:fill-mdx": "tsx scripts/togstrek-fill-mdx-empty-image-exif.ts",
    "start": "next start",
    "lint": "eslint",
    "inventory:squarespace": "tsx scripts/squarespace-inventory.ts",
    "media:restructure": "tsx scripts/togstrek-restructure-media.ts",
    "media:fetch-places": "tsx scripts/togstrek-fetch-place-images.ts",
    "media:fetch-north-america": "tsx scripts/togstrek-fetch-north-america-images.ts",
    "media:fetch-africa": "tsx scripts/togstrek-fetch-africa-images.ts",
    "media:fetch-asia": "tsx scripts/togstrek-fetch-asia-images.ts",
    "media:fetch-oceania": "tsx scripts/togstrek-fetch-oceania-images.ts",
    "media:fix-migration-north-america": "tsx scripts/togstrek-fix-migration-north-america-layout.ts",
    "media:rekey-north-america-staging": "tsx scripts/togstrek-rekey-north-america-staging.ts",
    "r2:rekey-north-america": "python3 scripts/r2_copy_north_america_keys.py",
    "r2:copy-turkiye-media": "python3 scripts/r2_copy_asia_turkey_to_europe_turkiye.py",
    "migrate:hiking": "tsx scripts/migrate-squarespace-hiking.ts",
    "migrate:adventures": "tsx scripts/migrate-squarespace-adventures.ts",
    "normalize:adventure-mdx": "tsx scripts/normalize-adventure-mdx-featured-template.ts",
    "fix:adventure-mdx-attrs": "tsx scripts/fix-adventure-mdx-rsc-props.ts",
    "migrate:other-work": "tsx scripts/migrate-squarespace-other-work.ts",
    "migrate:photography": "tsx scripts/migrate-squarespace-photography.ts",
    "migrate:places:south-america": "tsx scripts/migrate-squarespace-places-south-america.ts",
    "migrate:places:north-america": "tsx scripts/migrate-squarespace-places-north-america.ts",
    "migrate:places:europe": "tsx scripts/migrate-squarespace-places-europe.ts",
    "migrate:places:antarctica": "tsx scripts/migrate-squarespace-places-antarctica.ts",
    "migrate:places:africa": "tsx scripts/migrate-squarespace-places-africa.ts",
    "migrate:places:asia": "tsx scripts/migrate-squarespace-places-asia.ts",
    "migrate:places:oceania": "tsx scripts/migrate-squarespace-places-oceania.ts",
    "fix:photography-mdx": "tsx scripts/fix-photography-mdx-blog-boilerplate.ts",
    "data:other-work:featured": "tsx scripts/refresh-other-work-section-featured.ts",
    "r2:upload": "python3 scripts/r2_upload.py",
    "import:wxr": "tsx scripts/wxr-to-mdx.ts",
    "figma:connect:parse": "node --env-file=.env ./node_modules/@figma/code-connect/dist/cli.js connect parse --config figma.config.json",
    "figma:connect:publish": "node --env-file=.env ./node_modules/@figma/code-connect/dist/cli.js connect publish --config figma.config.json",
    "figma:connect:publish:skip-validation": "node --env-file=.env ./node_modules/@figma/code-connect/dist/cli.js connect publish --config figma.config.json --skip-validation"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "maplibre-gl": "^5.21.0",
    "next": "16.2.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.0",
    "remark-gfm": "^4.0.1",
    "remark-unwrap-images": "^4.0.1",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.2",
    "@pagefind/default-ui": "^1.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.5.9",
    "pagefind": "^1.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "yaml": "^2.8.3"
  }
}
